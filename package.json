{
  "name": "polyechanges",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "collect": "tsx pipeline/cli/collect.ts",
    "partners:init": "tsx pipeline/cli/partners.ts init",
    "partners:check": "tsx pipeline/cli/partners.ts check",
    "source:add": "tsx pipeline/cli/sources.ts add",
    "source:find": "tsx pipeline/cli/sources.ts find",
    "verify-sources": "tsx pipeline/cli/sources.ts verify",
    "refresh-sources": "tsx pipeline/cli/sources.ts refresh",
    "refresh": "tsx pipeline/cli/refresh.ts",
    "saved:xls-to-txt": "tsx pipeline/cli/xlsToTxt.ts",
    "compare": "tsx pipeline/cli/compare.ts",
    "export": "tsx pipeline/cli/export.ts",
    "freeze": "tsx pipeline/cli/freeze.ts",
    "calibrate:prepare": "tsx pipeline/cli/calibrate.ts prepare",
    "calibrate:run": "tsx pipeline/cli/calibrate.ts run",
    "calibrate:sample": "tsx pipeline/cli/calibrate.ts sample",
    "calibrate:sample-2": "tsx pipeline/cli/calibrate.ts sample-2",
    "calibrate:score": "tsx pipeline/cli/calibrate.ts score",
    "calibrate:clean": "tsx pipeline/cli/calibrate.ts clean",
    "test:model": "cross-env RUN_MODEL_TESTS=1 vitest run pipeline/compare/determinism.model.test.ts",
    "dev": "vite --config site/vite.config.ts",
    "build": "vite build --config site/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "d3-geo": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "topojson-client": "^3.1.0",
    "unpdf": "^1.9.1",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
